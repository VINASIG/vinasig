---
import { ArrowDown, ArrowUpRight, ChevronRight } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import {
  tools,
  foundations,
  siteUrl,
  siteDescription,
  toolDestination,
} from '../data/projects';
import dictionary from '../locales/vi.json';
import { translateCopy } from '../lib/localization.ts';
const lang = Astro.url.pathname.includes('/vi/') ? 'vi' : 'en';
const canonical = siteUrl + (lang === 'vi' ? 'vi/' : '');
const t = (value: string): string =>
  lang === 'vi' ? translateCopy(value, dictionary) : value;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'VINASIG',
      url: siteUrl,
      logo: `${siteUrl}brand/social.png`,
      sameAs: ['https://github.com/VINASIG'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'VINASIG',
      url: canonical,
      description: t(siteDescription),
      inLanguage: lang,
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#page`,
      name: lang === 'vi' ? 'Các dự án VINASIG' : 'VINASIG projects',
      url: canonical,
      description: t(siteDescription),
      inLanguage: lang,
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: tools.map((tool, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: toolDestination(tool, lang),
          name: tool.name,
        })),
      },
    },
  ],
};
---

<SiteLayout schema={schema}>
  <section class="hero" aria-labelledby="page-title">
    <h1 id="page-title">
      Useful tools.
      <br />
      Built with care.
    </h1>
    <p class="hero-copy">
      VINASIG builds practical software with SI agents. Start with a tool, or
      explore the shared standards behind our projects.
    </p>
    <a class="primary-action" href="#tools">
      Explore the tools
      <ArrowDown size={18} aria-hidden="true" />
    </a>
  </section>
  <section id="tools" class="section" aria-labelledby="tools-title">
    <header class="section-heading">
      <h2 id="tools-title">Tools for everyday tasks</h2>
      <p>Open a tool and get to work. No account required.</p>
    </header>
    <div class="tool-grid">
      {tools.map((tool) => (
        <ToolCard tool={{ ...tool, url: toolDestination(tool, lang) }} />
      ))}
    </div>
    <p class="privacy-note">
      Inputs and files are processed in your browser. Our tools do not upload
      them to a server.
    </p>
  </section>
  <section id="foundations" class="section" aria-labelledby="foundations-title">
    <header class="section-heading">
      <h2 id="foundations-title">The foundations behind the projects</h2>
      <p>Shared resources for building and maintaining VINASIG software.</p>
    </header>
    <div class="foundation-list">
      {foundations.map((project) => (
        <article class="foundation" aria-labelledby={`${project.slug}-title`}>
          <h3 id={`${project.slug}-title`}>
            <a href={project.url}>
              {project.name}
              <ArrowUpRight size={16} aria-hidden="true" />
            </a>
          </h3>
          <p>{project.description}</p>
        </article>
      ))}
    </div>
  </section>
  <section id="about" class="section about" aria-labelledby="about-title">
    <div class="about-copy">
      <h2 id="about-title">About VINASIG</h2>
      <p>
        We build software and technology with Super Intelligence agents. Our
        projects focus on useful tasks, clear interfaces and careful
        verification.
      </p>
      <a class="text-link" href="https://github.com/orgs/VINASIG/repositories">
        Explore all repositories
        <ArrowUpRight size={16} aria-hidden="true" />
      </a>
    </div>
    <div class="questions" role="group" aria-label="About the tools">
      <details>
        <summary>
          Do the tools need an account?
          <ChevronRight size={18} aria-hidden="true" />
        </summary>
        <p>
          All listed tools work without signing in. Their inputs and files are
          processed locally in your browser.
        </p>
      </details>
      <details>
        <summary>
          What does SI mean at VINASIG?
          <ChevronRight size={18} aria-hidden="true" />
        </summary>
        <p>
          SI stands for Super Intelligence. It is VINASIG's preferred term for
          the agents used in our workflow.
        </p>
      </details>
      <details>
        <summary>
          Where can I report a problem?
          <ChevronRight size={18} aria-hidden="true" />
        </summary>
        <p>
          Use the Source link on a tool to find its repository and issue
          tracker. For a website issue,{' '}
          <a href="https://github.com/VINASIG/vinasig/issues">
            open the website issue tracker
          </a>
          . For sensitive findings, use the repository's private security
          reporting channel.
        </p>
      </details>
    </div>
  </section>
</SiteLayout>
