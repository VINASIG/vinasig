---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Page not found | VINASIG"
  description="This VINASIG page could not be found. Return to the homepage to discover our tools and projects."
  notFound
>
  <section class="not-found" aria-labelledby="missing-title">
    <h1 id="missing-title">Page not found</h1>
    <p>The page may have moved, or the address may be incomplete.</p>
    <a
      class="primary-action"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/`}
    >
      Return to VINASIG
    </a>
  </section>
</SiteLayout>
