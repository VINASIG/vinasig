---
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/site-chrome.css';
import '../styles/tokens.css';
import '../styles/app.css';
import '../styles/control-surfaces.css';
import { siteUrl, siteDescription } from '../data/projects';
import ThemeInit from '../components/ThemeInit.astro';
import SitePreferences from '../components/SitePreferences.astro';
import Localized from '../components/Localized.astro';
import dictionary from '../locales/vi.json';
import { translateCopy } from '../lib/localization.ts';
interface Props {
  title?: string;
  description?: string;
  notFound?: boolean;
  schema?: object;
}
const {
  title = 'VINASIG | Practical tools and projects',
  description = siteDescription,
  notFound = false,
  schema,
} = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const lang = Astro.url.pathname.includes('/vi/') ? 'vi' : 'en';
const t = (value: string): string =>
  lang === 'vi' ? translateCopy(value, dictionary) : value;
const home = base + (lang === 'vi' ? 'vi/' : '');
const canonical = siteUrl + (lang === 'vi' ? 'vi/' : '');
const alternate = notFound
  ? lang === 'vi'
    ? `${base}404.html`
    : `${base}vi/404/`
  : lang === 'vi'
    ? base
    : `${base}vi/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{t(title)}</title>
    <meta name="description" content={t(description)} />
    {notFound ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    {!notFound && (
      <>
        <link rel="alternate" hreflang="en" href={siteUrl} />
        <link rel="alternate" hreflang="vi" href={`${siteUrl}vi/`} />
        <link rel="alternate" hreflang="x-default" href={siteUrl} />
      </>
    )}
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VINASIG" />
    <meta property="og:title" content={t(title)} />
    <meta property="og:description" content={t(description)} />
    <meta
      property="og:url"
      content={notFound ? `${canonical}404.html` : canonical}
    />
    <meta property="og:image" content={`${siteUrl}brand/social.png`} />
    <meta property="og:image:alt" content={t('VINASIG brand mark')} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={t(title)} />
    <meta name="twitter:description" content={t(description)} />
    <meta name="twitter:image" content={`${siteUrl}brand/social.png`} />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={`${base}brand/favicon-16.png`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${base}brand/favicon-32.png`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href={`${base}brand/favicon-48.png`}
    />
    <link
      rel="preload"
      href={`${base}fonts/SpaceGrotesk-VariableFont_wght.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href={`${base}fonts/font.css`} />
    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
      />
    )}
    <ThemeInit />
  </head>
  <body>
    <Localized lang={lang}>
      <a class="skip-link" href="#main">
        Skip to content
      </a>
      <header class="site-header chrome-container" data-site-header>
        <a
          class="brand"
          href="https://vinasig.io.vn/"
          aria-label="VINASIG home"
          data-brand-logo
        >
          <picture>
            <source
              media="(prefers-color-scheme: dark)"
              srcset={`${base}brand/reversed.svg`}
            />
            <script is:inline>
              document.currentScript?.previousElementSibling?.setAttribute(
                'media',
                document.documentElement.dataset.theme === 'dark'
                  ? 'all'
                  : 'not all',
              );
            </script>
            <img
              src={`${base}brand/primary-color.svg`}
              alt="VINASIG"
              width="540"
              height="140"
            />
          </picture>
        </a>

        <SitePreferences lang={lang} alternate={alternate} />
      </header>
      <nav class="project-navigation container" aria-label="Main">
        <a href={`${home}#tools`}>Projects</a>
        <a href={`${home}#about`}>About</a>
        <a href="https://github.com/VINASIG">GitHub</a>
      </nav>
      <main id="main" class="container" tabindex="-1">
        <slot />
      </main>
      <SiteFooter
        lang={lang}
        source="https://github.com/VINASIG/vinasig"
        issues="https://github.com/VINASIG/vinasig/issues"
        licenses={`${base}licenses/NOTICE.txt`}
        class="chrome-container"
      >
        <a href="https://github.com/VINASIG/vinasig-org-directory">
          Contact directory
        </a>
      </SiteFooter>
    </Localized>
  </body>
</html>
